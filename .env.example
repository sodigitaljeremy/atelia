# Copier ce fichier en .env puis renseigner la clé (https://console.mistral.ai)
MISTRAL_API_KEY=

# Mot de passe Postgres (requis par docker compose — valeur forte en prod)
POSTGRES_PASSWORD=

# Modèles derrière LiteLLM — swappables (ex. Claude : anthropic/claude-sonnet-5)
LLM_MODEL=mistral/mistral-large-latest
EMBED_MODEL=mistral/mistral-embed
